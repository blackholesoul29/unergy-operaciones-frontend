+// La energía comprometida de un PPA vive en `compromisos_energia`: una fila por
+// mes, en MWh (así la rotula el detalle del contrato). Los campos planos del
+// contrato -- cantidad_minima/maxima_kwh_mes, en kWh -- están vacíos en los 33
+// contratos de producción (revisado 2026-08-22), así que el Excel NO los saca:
+// serían dos columnas en blanco, y en otra unidad que la curva. Si algún día se
+// llenan, hay que agregarlos aparte, nunca como "fallback" de estos.
+//
+// Se exportan dos parejas porque responden preguntas distintas: qué debe el
+// contrato ESTE mes, y entre qué topes se mueve en toda su vida.
+// `campo` es 'energia_minima' | 'energia_maxima'; `f` es Math.min | Math.max.
+function rangoCompromisos(c, campo, f) {
+  const v = (c.compromisos_energia || []).map(x => x[campo]).filter(x => x != null).map(Number)
+  return v.length ? f(...v) : ''
+}
+
+const HOY = new Date()
+
+// Mismo criterio que `resumenCantidades.actual` en el detalle del contrato:
+// la fila del año y mes de hoy, o nada si el contrato no la tiene.
+function compromisoMesActual(c, campo) {
+  const r = (c.compromisos_energia || []).find(
+    x => x.año === HOY.getFullYear() && x.mes === HOY.getMonth() + 1)
+  return r?.[campo] ?? ''
+}
